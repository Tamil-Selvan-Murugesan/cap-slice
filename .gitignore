# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
data/
venv/
.python-version

# Virtual environments
.venv
r2.env

# Downloaded documents (large binaries; re-create with cap-slice-download)
data/*/*/*.pdf
data/*/*/*.zip
data/*/*/*.part

# Local Qdrant vector store (re-create with cap-slice-index)
data/qdrant/

# Parsing evaluation / GPU benchmark data: all generated under data/parsing_eval/ (covered by data/).
# Belt and braces in case outputs are written elsewhere by hand:
*.zip
*.tmp
results*/
vlm_results*/
venvs/
*.png
*.jpg

